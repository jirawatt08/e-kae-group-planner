rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Direct and resilient role check
    function getRole(data) {
      return data.get('members', {}).get(request.auth.uid, null);
    }

    // Direct check for Owner
    function isOwner(data) {
      return isSignedIn() && (
        data.get('ownerId', '') == request.auth.uid || 
        getRole(data) == 'owner'
      );
    }



    match /trips/{tripId} {
      // READ: get any trip by ID (needed for join flow via direct links)
      allow get: if isSignedIn();

      // LIST: only members/owners can query trips
      allow list: if isSignedIn() && (
        resource.data.get('ownerId', '') == request.auth.uid ||
        getRole(resource.data) != null
      );
      
      // CREATE: any signed-in user
      allow create: if isSignedIn();
      
      // UPDATE: role-based with field protection
      allow update: if isSignedIn() && (
        // OWNER BRANCH: Can update any field EXCEPT ownerId and createdAt
        ((resource.data.get('ownerId', '') == request.auth.uid || getRole(resource.data) == 'owner')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt']))
        
        // EDITOR BRANCH: Limited to name, description, updatedAt
        || (getRole(resource.data) == 'editor' && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'updatedAt']))
        
        // JOIN BRANCH: Valid code, not expired, only adding self as member
        || (resource.data.get('isJoinEnabled', false) == true && 
            request.resource.data.get('inviteCode', '') == resource.data.get('inviteCode', '') &&
            request.time < resource.data.get('lastCodeGeneratedAt', request.time) + duration.value(30, 'm') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']))
      );
      
      allow delete: if isOwner(resource.data);

      // Sub-collections use broad rules for authenticated users
      match /{subcollection=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
    
    // Global profile permissions
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /profiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
